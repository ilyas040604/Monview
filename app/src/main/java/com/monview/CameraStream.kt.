
package com.monview

import android.content.Context
import org.webrtc.AudioSource
import org.webrtc.AudioTrack
import org.webrtc.Camera2Enumerator
import org.webrtc.CameraVideoCapturer
import org.webrtc.EglBase
import org.webrtc.MediaConstraints
import org.webrtc.PeerConnection
import org.webrtc.PeerConnectionFactory
import org.webrtc.SurfaceTextureHelper
import org.webrtc.VideoSource
import org.webrtc.VideoTrack

class CameraStream(private val context: Context) {

    private var capturer: CameraVideoCapturer? = null
    private var videoSource: VideoSource? = null
    private var audioSource: AudioSource? = null

    var videoTrack: VideoTrack? = null
        private set

    var audioTrack: AudioTrack? = null
        private set

    private var textureHelper: SurfaceTextureHelper? = null

    fun start(): Boolean {
        WebRtcManager.initialize(context)

        val factoryField = PeerConnectionFactory::class.java
            .getDeclaredField("unused")
        // Inisialisasi trek dilakukan pada langkah berikutnya.
        return true
    }

    fun stop() {
        capturer?.stopCapture()
        capturer?.dispose()
        capturer = null

        videoTrack?.dispose()
        videoTrack = null

        audioTrack?.dispose()
        audioTrack = null

        videoSource?.dispose()
        videoSource = null

        audioSource?.dispose()
        audioSource = null

        textureHelper?.dispose()
        textureHelper = null
    }
}
